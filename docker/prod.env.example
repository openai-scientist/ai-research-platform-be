# Copy this file to prod.env.local and replace every placeholder before deployment.
POSTGRES_DB=platform
POSTGRES_USER=platform
# Keep this value identical to the password in DATABASE_URL; URL-encode reserved URL characters.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://platform:replace-with-a-long-random-password@db:5432/platform
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
SESSION_SIGNING_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_COOKIE_NAME=__Host-platform_session
COOKIE_SAMESITE=lax
AUTH_SESSION_RATE_LIMIT=10
AUTH_CODE_RATE_LIMIT=20
AUTH_SESSION_RATE_WINDOW_SECONDS=60
REQUEST_MAX_BODY_BYTES=1048576
API_PORT=8080
# Memory the API container may use before it is stopped and restarted. About half of the
# host's memory, and not below 1g: the database and the proxy need the rest.
API_MEMORY_LIMIT=1g
# Uploads may be larger than REQUEST_MAX_BODY_BYTES; these limits apply to them.
DATASET_MAX_UPLOAD_BYTES=52428800
ARTIFACT_MAX_UPLOAD_BYTES=52428800
PROJECT_FILE_MAX_UPLOAD_BYTES=52428800
AVATAR_MAX_UPLOAD_BYTES=4194304
# Where files are kept: "local" (the storage volume) or "r2" (Cloudflare R2, needs the R2_ values).
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Only for a bucket with a jurisdiction, e.g. https://<account-id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Email through Resend. Required: the API does not start in production without the key.
# Key: resend.com > API Keys, "Sending access", limited to the verified domain.
RESEND_API_KEY=
# Must be an address on the domain verified in Resend.
EMAIL_FROM=AI Research Platform <no-reply@beyond8.io.vn>
# Frontend address put in emails as the sign-in link; must start with https://
APP_URL=https://your-frontend.example.com
# Sign-in with Google. Leave all three empty to keep it off. The redirect URI must be listed
# under "Authorised redirect URIs" of the OAuth client in the Google Cloud console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Google Sheets and Google Drive data connections: this API's
# /api/v1/connections/google/callback, listed on the same client. Empty: the two kinds are
# off. They also need APP_URL and CONNECTION_SECRET_KEY.
GOOGLE_OAUTH_CONNECTIONS_REDIRECT_URI=
# Google Picker: browser API key restricted to Google Picker API, the frontend domain,
# and https://docs.google.com/*. APP_ID is the Cloud project NUMBER of the OAuth client.
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=
# Popper integration. Leave POPPER_BASE_URL empty to run without it (runs cannot start).
POPPER_BASE_URL=
# Two different random secrets of at least 32 characters, shared with Popper.
POPPER_SERVICE_KEY=
POPPER_CALLBACK_KEY=
POPPER_TIMEOUT_SECONDS=30
# Address Popper uses to reach this API, without the /api/v1 prefix.
PUBLIC_BASE_URL=https://your-platform-api.example.com
RUN_DEFAULT_BUDGET_USD=5
RUN_MAX_BUDGET_USD=20
# Data connections (external databases a project can read from). Passwords are encrypted
# with this key before they are stored. Empty: the feature is off.
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy: losing or replacing it makes every saved connection unusable until re-created.
CONNECTION_SECRET_KEY=
CONNECTION_CONNECT_TIMEOUT_SECONDS=10
CONNECTION_QUERY_TIMEOUT_SECONDS=60
CONNECTION_IMPORT_TIMEOUT_SECONDS=300
CONNECTION_MAX_CONCURRENT_QUERIES=4
CONNECTION_MAX_CONCURRENT_PER_OWNER=2
CONNECTION_PROBE_RATE_LIMIT=30
CONNECTION_QUERY_RATE_LIMIT=120
CONNECTION_PREVIEW_MAX_ROWS=100
CONNECTION_BIGQUERY_MAX_BYTES_BILLED=1073741824
