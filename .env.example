DATABASE_URL=postgresql+asyncpg://platform:platform-local-only@db:5432/platform
SESSION_SIGNING_SECRET=local-only-session-secret-change-me-32

# Popper is the separate service that runs the research. Leave POPPER_BASE_URL empty
# until it is available: everything except starting a run works without it.
POPPER_BASE_URL=
# Sent by the Platform to Popper in X-Service-Key.
POPPER_SERVICE_KEY=
# Expected from Popper in X-Service-Key when it calls /api/v1/internal/popper/...
POPPER_CALLBACK_KEY=
# Address Popper uses to reach this API, without the /api/v1 prefix.
PUBLIC_BASE_URL=http://localhost:8000
